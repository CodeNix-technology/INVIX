# Invix environment configuration
# Copy to .env.local and fill in your Supabase project credentials.

# Supabase (cloud auth, Postgres, storage)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: enable a custom default storage provider
VITE_STORAGE_PROVIDER=supabase # supabase | local

# App
VITE_APP_NAME=Invix
